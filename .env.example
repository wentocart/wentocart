APP_NAME=WentoCart
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wentocart
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=
SESSION_PATH=/
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
WENTO_LANGUAGE=en
WENTO_CURRENCY=USD
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=WentoCart
WENTO_INSTALLED=false
SESSION_ENCRYPT=true
SESSION_ADMIN_LIFETIME=120
SESSION_CUSTOMER_LIFETIME=480
# Laravel Octane (recommended production HTTP). Servers: frankenphp|roadrunner|swoole
OCTANE_SERVER=frankenphp
# HTTP server: serve|octane — production docs recommend octane
WENTO_SERVER=serve

# Redis (recommended production cache / session / queue)
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

# Object storage (S3 / Cloudflare R2 / local MinIO). Leave driver local for disk uploads.
# FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Admin inbox: null = SSE-only; set redis|pusher|reverb to also broadcast AdminInboxUpdated
BROADCAST_CONNECTION="null"
# GraphiQL at /api/v1/graphiql (also on when APP_DEBUG=true)
GRAPHQL_PLAYGROUND=false
# API playground key auto-inject (OFF on public stores)
STOREFRONT_PLAYGROUND_KEY=
API_PLAYGROUND_AUTO_INJECT_STOREFRONT_KEY=false
